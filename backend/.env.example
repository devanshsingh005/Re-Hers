# Audiveris API Configuration
# Get this from your Audiveris instance or ngrok tunnel
AUDIVERIS_API_URL=http://localhost:8080
REQUEST_TIMEOUT=300

# Supabase Configuration
# Get these from your Supabase project dashboard (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Storage Bucket Names
SUPABASE_BUCKET=sheet_data
PDF_BUCKET=pdf_uploads

# File Upload Limits
MAX_FILE_SIZE=104857600

# Redis Configuration (for horizontal scaling)
# Optional - only needed if scaling to multiple nodes
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development
