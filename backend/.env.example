# Audiveris API Configuration
# Get this from your Audiveris instance or ngrok tunnel
AUDIVERIS_API_URL=http://localhost:8080
REQUEST_TIMEOUT=300

# Supabase Configuration
# Get these from your Supabase project dashboard (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Storage Bucket Names
SUPABASE_BUCKET=sheet_data
PDF_BUCKET=pdf_uploads

# File Upload Limits
MAX_FILE_SIZE=104857600

# CORS — comma-separated list of allowed origins (e.g. https://app.example.com,https://www.example.com)
# Leave empty to allow all origins (useful for development; restrict in production)
ALLOWED_ORIGINS=

# Admin access — comma-separated list of Supabase user UUIDs that may call /admin/* endpoints
# Leave empty to disable admin endpoints for all users
ADMIN_USER_IDS=

# Redis Configuration (for horizontal scaling)
# Optional - only needed if scaling to multiple nodes
REDIS_URL=redis://localhost:6379

# Environment
ENVIRONMENT=development
